{
  "$defs": {
    "AssentEntry": {
      "additionalProperties": false,
      "else": {
        "if": {
          "properties": {
            "role": {
              "const": "decline"
            }
          },
          "required": [
            "role"
          ]
        },
        "then": {
          "properties": {
            "ground": true
          },
          "required": [
            "ground"
          ]
        }
      },
      "if": {
        "properties": {
          "role": {
            "const": "commitment"
          }
        },
        "required": [
          "role"
        ]
      },
      "properties": {
        "at": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Instant",
          "description": "When the party wrote the entry, by its own statement. No rule reads order from it"
        },
        "ground": {
          "$ref": "#/$defs/AssentEntryGround",
          "description": "Why the seller declined. Core terms: `availability` | `exclusivity` | `terms`, the grounds of § 4.3.2. Absent on any other entry. A receiver that doesn't know a term still reads the entry as a `decline`"
        },
        "idempotency_key": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId",
          "description": "Buyer-generated, unique per `commit`, opaque, and scoped to one buyer and seller pair. The seller MUST NOT interpret it (§ 5.6.1)"
        },
        "line_item_ids": {
          "description": "The line items the entry names. MUST be non-empty",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/MintedId"
          },
          "type": "array"
        },
        "record_digest": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/QualifiedDigest",
          "description": "Of the binding record for the line items in `line_item_ids[]` (§ 4.1.1)"
        },
        "role": {
          "$ref": "#/$defs/AssentEntryRole",
          "description": "`commitment` | `acceptance` | `withdrawal` | `decline`. It says what the entry does, and it implies the party"
        },
        "version": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count",
          "description": "The `version` of the record the digest was computed over. `version` is outside the binding record, so the entry binds it"
        }
      },
      "required": [
        "at",
        "line_item_ids",
        "record_digest",
        "role",
        "version"
      ],
      "then": {
        "properties": {
          "idempotency_key": true
        },
        "required": [
          "idempotency_key"
        ]
      },
      "type": "object"
    },
    "AssentEntryGround": {
      "anyOf": [
        {
          "enum": [
            "availability",
            "exclusivity",
            "terms"
          ],
          "type": "string"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "AssentEntryRole": {
      "enum": [
        "commitment",
        "acceptance",
        "withdrawal",
        "decline"
      ],
      "type": "string"
    },
    "ChangeRequest": {
      "additionalProperties": false,
      "dependentSchemas": {
        "baseline": {
          "properties": {
            "baseline": {
              "properties": {
                "line_item_id": true
              },
              "required": [
                "line_item_id"
              ],
              "type": "object"
            }
          }
        }
      },
      "properties": {
        "accountid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId",
          "description": "The account of the advertiser and buyer that own the change, the same as the OpenDirect Order's. An OpenDirect 2.1 ChangeRequest requires it"
        },
        "actor": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Side",
          "description": "The side that wrote the entry"
        },
        "at": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Instant",
          "description": "When that side wrote it"
        },
        "baseline": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/VersionRef",
          "description": "The agreed line item the request is against, at the `version` of its agreed record (§ 4.1.2). `line_item_id` is REQUIRED here"
        },
        "cancellation": {
          "$ref": "../../commercial/1/commercial.json#/$defs/CancellationNotice",
          "description": "The notice, when the request is to cancel under the option in effect (§ 5.6.6)"
        },
        "comments": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Text",
          "description": "Why the change is requested. Free text"
        },
        "contacts": {
          "description": "Contacts for this change, in addition to the buyer's and the advertiser's, one per contact type. As OpenDirect 2.1 Contact",
          "items": {
            "$ref": "#/$defs/Contact"
          },
          "type": "array"
        },
        "ext": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Ext",
          "description": "See Extensions (§ 2.5)"
        },
        "id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/MintedId",
          "description": "Opaque identifier of the change request"
        },
        "lineid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId",
          "description": "The Line in that Order, for a change at line level"
        },
        "orderid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId",
          "description": "The order the change is requested for: the id in the `order` entry"
        },
        "requesterid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId",
          "description": "The organization that requests the change: usually the agency, or the publisher. An OpenDirect 2.1 ChangeRequest requires it"
        },
        "status": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ApprovalStatus",
          "description": "The outcome of the request"
        }
      },
      "required": [
        "actor",
        "at",
        "baseline",
        "id"
      ],
      "type": "object"
    },
    "Contact": {
      "additionalProperties": true,
      "description": "Its content is set by OpenDirect 2.1's `Contact` object, one per contact type (§ 4.4)",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "action": {
            "const": "requested"
          }
        },
        "required": [
          "action"
        ]
      },
      "properties": {
        "action": {
          "$ref": "#/$defs/NegotiationAction",
          "description": "`published` | `requested` | `granted` | `countered` | `declined` | `withdrawn`. § 4.3.1 says which interaction writes each"
        },
        "actor": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Side",
          "description": "The side that acted"
        },
        "at": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Instant",
          "description": "When the side acted"
        },
        "paths": {
          "description": "The fields the act changed or asked about. MAY be empty",
          "items": {
            "$ref": "#/$defs/HistoryPath"
          },
          "type": "array"
        },
        "version": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count",
          "description": "The version the act created or refers to (§ 4.1.3)"
        }
      },
      "required": [
        "action",
        "actor",
        "at",
        "paths",
        "version"
      ],
      "then": {
        "properties": {
          "paths": {
            "items": {
              "properties": {
                "requested_value": true
              },
              "required": [
                "requested_value"
              ],
              "type": "object"
            },
            "type": "array"
          }
        }
      },
      "type": "object"
    },
    "HistoryPath": {
      "additionalProperties": false,
      "dependentRequired": {
        "requested_value": [
          "line_item_id"
        ]
      },
      "properties": {
        "line_item_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/MintedId",
          "description": "The line item. When absent, `pointer` is into the proposal"
        },
        "pointer": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/FieldPointer",
          "description": "Into that line item or the proposal"
        },
        "requested_value": {
          "$ref": "#/$defs/RequestedValue",
          "description": "On a `requested` entry, the value the buyer asked for. On a `declined` entry, or a buyer's `withdrawn` entry, the value of the `request` it ended. Absent on every other entry"
        }
      },
      "required": [
        "pointer"
      ],
      "type": "object"
    },
    "MinCommitment": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "basis": {
            "const": "units"
          }
        },
        "required": [
          "basis"
        ]
      },
      "properties": {
        "amount": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Amount",
          "description": "The figure committed: an `Amount` when `basis` is `spend`, otherwise a whole number of the entry's units (§ 5.6.5)"
        },
        "basis": {
          "$ref": "../../commercial/1/commercial.json#/$defs/CommitmentBasis",
          "description": "`spend` | `units`"
        },
        "line_item_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/MintedId",
          "description": "A line item in the package's `line_items[]`"
        }
      },
      "required": [
        "amount",
        "basis",
        "line_item_id"
      ],
      "then": {
        "properties": {
          "amount": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/Count"
          }
        }
      },
      "type": "object"
    },
    "NegotiationAction": {
      "enum": [
        "published",
        "requested",
        "granted",
        "countered",
        "declined",
        "withdrawn"
      ],
      "type": "string"
    },
    "Package": {
      "additionalProperties": false,
      "properties": {
        "add_ons": {
          "description": "Line items sold only with all of `line_items[]`, such as a bonus line item (§ 5.6.3)",
          "items": {
            "$ref": "../../../documents/1/line-item.json"
          },
          "type": "array"
        },
        "line_items": {
          "description": "The line items sold only together. It holds at least one entry",
          "items": {
            "$ref": "../../../documents/1/line-item.json"
          },
          "type": "array"
        },
        "min_commitments": {
          "description": "Thresholds a `commit` meets to include an add-on",
          "items": {
            "$ref": "#/$defs/MinCommitment"
          },
          "type": "array"
        },
        "package_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/MintedId",
          "description": "Identity within the proposal"
        }
      },
      "required": [
        "line_items",
        "package_id"
      ],
      "type": "object"
    },
    "ProposalType": {
      "enum": [
        "standard",
        "custom"
      ],
      "type": "string"
    },
    "RequestedValue": {
      "additionalProperties": false,
      "properties": {
        "commitment_bounds": {
          "$ref": "../../commercial/1/commercial.json#/$defs/CommitmentBounds",
          "description": "The line item's `commitment_bounds`"
        },
        "committed_metrics": {
          "description": "The line item's `committed_metrics[]`",
          "items": {
            "$ref": "../../guarantees/1/guarantees.json#/$defs/CommittedMetric"
          },
          "type": "array"
        },
        "list_rate": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Amount",
          "description": "A `pricing[].list_rate`"
        },
        "materials_due": {
          "$ref": "../../creative/1/creative.json#/$defs/MaterialsDue",
          "description": "The line item's `materials_due`"
        },
        "retention": {
          "$ref": "../../execution/1/execution.json#/$defs/RetentionRange",
          "description": "The line item's `retention`"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://jsonspecs.com/openproposal/schemas/with-open-prs/modules/proposal/1/proposal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal `proposal` module: the vocabularies, objects, unions, and constructor copies of § 4, § 4.1, § 4.1.1, § 4.1.2, § 4.1.3, § 4.1.4, § 4.2, § 4.3, § 4.3.1, § 4.3.2, § 4.3.3, § 4.3.4, and § 4.4.",
  "title": "proposal"
}
