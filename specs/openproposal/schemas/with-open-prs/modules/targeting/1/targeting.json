{
  "$defs": {
    "AcceptedExclusions": {
      "additionalProperties": false,
      "properties": {
        "types": {
          "additionalProperties": {
            "$ref": "#/$defs/ExclusionTerms"
          },
          "description": "The exclusion types the seller accepts (core terms above), and its terms for each",
          "propertyNames": {
            "$ref": "#/$defs/ExclusionType"
          },
          "type": "object"
        },
        "verification": {
          "description": "The third parties that can attest the seller enforced these lists",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/RegistrableDomain"
          },
          "type": "array"
        }
      },
      "required": [
        "types"
      ],
      "type": "object"
    },
    "CountSettableRange": {
      "additionalProperties": false,
      "description": "A field the buyer sets to a value between the bounds the seller allows, for a type whose values are ordered, such as a frequency cap's count. It holds the keys of a `Range` and the two the buyer reads and writes.",
      "minProperties": 2,
      "properties": {
        "default": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count"
        },
        "max": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count"
        },
        "min": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count"
        },
        "value": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count"
        }
      },
      "required": [
        "default"
      ],
      "type": "object"
    },
    "DaypartBounds": {
      "additionalProperties": false,
      "description": "A field the buyer sets to one of the values the seller allows, `allowed[]`, for a type whose values have no order, such as a geo code or a device category.",
      "properties": {
        "allowed": {
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/DaypartWindow"
          },
          "type": "array"
        },
        "default": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "items": {
                "$ref": "../../../kernel/1/kernel.json#/$defs/DaypartWindow"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "$ref": "../../../kernel/1/kernel.json#/$defs/DaypartWindow"
              },
              "type": "array"
            }
          },
          "required": [
            "include"
          ],
          "type": "object"
        },
        "value": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "items": {
                "$ref": "../../../kernel/1/kernel.json#/$defs/DaypartWindow"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "$ref": "../../../kernel/1/kernel.json#/$defs/DaypartWindow"
              },
              "type": "array"
            }
          },
          "required": [
            "include"
          ],
          "type": "object"
        }
      },
      "required": [
        "allowed",
        "default"
      ],
      "type": "object"
    },
    "DeviceBounds": {
      "additionalProperties": false,
      "description": "A field the buyer sets to one of the values the seller allows, `allowed[]`, for a type whose values have no order, such as a geo code or a device category.",
      "properties": {
        "allowed": {
          "items": {
            "$ref": "#/$defs/DeviceType"
          },
          "type": "array"
        },
        "default": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "items": {
                "$ref": "#/$defs/DeviceType"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "$ref": "#/$defs/DeviceType"
              },
              "type": "array"
            }
          },
          "required": [
            "include"
          ],
          "type": "object"
        },
        "value": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "items": {
                "$ref": "#/$defs/DeviceType"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "$ref": "#/$defs/DeviceType"
              },
              "type": "array"
            }
          },
          "required": [
            "include"
          ],
          "type": "object"
        }
      },
      "required": [
        "allowed",
        "default"
      ],
      "type": "object"
    },
    "DeviceType": {
      "$ref": "https://jsonspecs.com/adcom/schemas/modules/lists/1/lists.json#/$defs/DeviceType",
      "description": "The codes of AdCOM 1.0 List: Device Types (https://github.com/InteractiveAdvertisingBureau/AdCOM/blob/26c59ba1b235cd8d938c9877409e506f1b8d3f0c/AdCOM%20v1.0%20FINAL.md#list_devicetypes), as the AdCOM 1.0 registry defines them"
    },
    "Enforcement": {
      "enum": [
        "pre_serve",
        "best_effort"
      ],
      "type": "string"
    },
    "ExclusionEntries": {
      "description": "An ordered list of values of one type.",
      "items": {
        "$ref": "#/$defs/ExclusionEntry"
      },
      "type": "array"
    },
    "ExclusionEntry": {
      "anyOf": [
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Domain"
        },
        {
          "$ref": "../../inventory/1/inventory.json#/$defs/AppId"
        },
        {
          "$ref": "../../audience/1/audience.json#/$defs/CategoryTaxonomyCodes"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Text"
        }
      ]
    },
    "ExclusionList": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExclusionEntries"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/DocumentRef"
        }
      ]
    },
    "ExclusionTerms": {
      "additionalProperties": false,
      "properties": {
        "enforcement": {
          "$ref": "#/$defs/Enforcement",
          "description": "`pre_serve` | `best_effort`"
        },
        "max_entries": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count",
          "description": "The most entries of this type the seller accepts"
        }
      },
      "required": [
        "enforcement"
      ],
      "type": "object"
    },
    "ExclusionType": {
      "anyOf": [
        {
          "enum": [
            "domains",
            "apps",
            "categories",
            "keywords"
          ],
          "type": "string"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "FrequencyCap": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "$ref": "#/$defs/CountSettableRange",
          "description": "The cap. The buyer's `value` is the count, and `period` and `per` stay the seller's"
        },
        "per": {
          "$ref": "#/$defs/FrequencyCapBasis",
          "description": "Who is capped. It matters: CTV typically caps at household, audio at listener. Core terms: `device` | `household` | `listener` | `screen`"
        },
        "period": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/TimeUnit",
          "description": "The bucket the count runs over"
        }
      },
      "required": [
        "count",
        "per",
        "period"
      ],
      "type": "object"
    },
    "FrequencyCapBasis": {
      "anyOf": [
        {
          "enum": [
            "device",
            "household",
            "listener",
            "screen"
          ],
          "type": "string"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "GeoBounds": {
      "additionalProperties": false,
      "description": "A field the buyer sets to one of the values the seller allows, `allowed[]`, for a type whose values have no order, such as a geo code or a device category.",
      "properties": {
        "allowed": {
          "items": {
            "$ref": "#/$defs/GeoCode"
          },
          "type": "array"
        },
        "default": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "items": {
                "$ref": "#/$defs/GeoCode"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "$ref": "#/$defs/GeoCode"
              },
              "type": "array"
            }
          },
          "required": [
            "include"
          ],
          "type": "object"
        },
        "value": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "items": {
                "$ref": "#/$defs/GeoCode"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "$ref": "#/$defs/GeoCode"
              },
              "type": "array"
            }
          },
          "required": [
            "include"
          ],
          "type": "object"
        }
      },
      "required": [
        "allowed",
        "default"
      ],
      "type": "object"
    },
    "GeoCode": {
      "anyOf": [
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ShortCountryCode"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/SubdivisionCode"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "MarketsSelection": {
      "additionalProperties": false,
      "description": "A field the buyer sets by choosing options from the set the seller declares. `included[]` names the options in the base rate, `selected[]` the buyer's own choice, and `deltas` the change in price for each option beyond those included.",
      "properties": {
        "available": {
          "items": {
            "$ref": "#/$defs/GeoCode"
          },
          "type": "array"
        },
        "deltas": {
          "additionalProperties": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/PriceDelta"
          },
          "propertyNames": {
            "$ref": "#/$defs/GeoCode"
          },
          "type": "object"
        },
        "included": {
          "items": {
            "$ref": "#/$defs/GeoCode"
          },
          "type": "array"
        },
        "max_select": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count"
        },
        "selected": {
          "items": {
            "$ref": "#/$defs/GeoCode"
          },
          "type": "array"
        }
      },
      "required": [
        "available",
        "included"
      ],
      "type": "object"
    }
  },
  "$id": "https://jsonspecs.com/openproposal/schemas/with-open-prs/modules/targeting/1/targeting.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal `targeting` module: the vocabularies, objects, unions, and constructor copies of § 5.5.",
  "title": "targeting"
}
