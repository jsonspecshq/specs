{
  "$defs": {
    "BuyerRequirements": {
      "additionalProperties": false,
      "properties": {
        "allowed_dsps": {
          "description": "The DSPs that may receive the deal (§ 5.8), each by its primary domain, as `SeatRef.dsp` (§ 2.2)",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/RegistrableDomain"
          },
          "type": "array"
        },
        "seat_owner": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Party",
          "description": "The legal entity that owns the seats. Absent: the `buyer`"
        },
        "seats": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/SeatRef",
          "description": "The buyer's seats on the deal, as the Deals API 1.0 `wseat`"
        },
        "seats_expected": {
          "description": "The seller asks the buyer to supply `seats`",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "DeliveryType": {
      "enum": [
        "guaranteed",
        "share_of_voice",
        "non_guaranteed"
      ],
      "type": "string"
    },
    "MechanismOption": {
      "additionalProperties": false,
      "properties": {
        "delivery_type": {
          "$ref": "#/$defs/DeliveryType",
          "description": "What the seller promises under this mechanism. The value on the mechanism in effect (§ 3.1) applies to the line item"
        },
        "id": {
          "$ref": "#/$defs/TransactionMechanism",
          "description": "The mechanism, which is the option id (§ 3.1)"
        }
      },
      "required": [
        "delivery_type",
        "id"
      ],
      "type": "object"
    },
    "RetentionRange": {
      "additionalProperties": false,
      "description": "A range of values from `min` to `max`, with at least one bound, such as the bounds within which the buyer sets a frequency cap.",
      "minProperties": 1,
      "properties": {
        "max": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Duration"
        },
        "min": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Duration"
        }
      },
      "type": "object"
    },
    "ServingMode": {
      "anyOf": [
        {
          "enum": [
            "dai",
            "scheduled",
            "embedded"
          ],
          "type": "string"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "SovBasis": {
      "enum": [
        "impressions",
        "loop_time"
      ],
      "type": "string"
    },
    "TransactionMechanism": {
      "enum": [
        "direct_io",
        "programmatic_guaranteed",
        "preferred_deal",
        "private_auction"
      ],
      "type": "string"
    },
    "TransactionMechanismSelection": {
      "additionalProperties": false,
      "description": "A field the buyer sets by choosing options from the set the seller declares. `included[]` names the options in the base rate, `selected[]` the buyer's own choice, and `deltas` the change in price for each option beyond those included.",
      "properties": {
        "available": {
          "items": {
            "$ref": "#/$defs/MechanismOption"
          },
          "type": "array"
        },
        "deltas": {
          "additionalProperties": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/PriceDelta"
          },
          "propertyNames": {
            "$ref": "#/$defs/TransactionMechanism"
          },
          "type": "object"
        },
        "included": {
          "items": {
            "$ref": "#/$defs/TransactionMechanism"
          },
          "type": "array"
        },
        "max_select": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Count"
        },
        "selected": {
          "items": {
            "$ref": "#/$defs/TransactionMechanism"
          },
          "type": "array"
        }
      },
      "required": [
        "available",
        "included"
      ],
      "type": "object"
    }
  },
  "$id": "https://jsonspecs.com/openproposal/schemas/with-open-prs/modules/execution/1/execution.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal `execution` module: the vocabularies, objects, unions, and constructor copies of § 5.9.",
  "title": "execution"
}
