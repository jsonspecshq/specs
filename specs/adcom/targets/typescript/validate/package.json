{
  "name": "@jsonspecshq/adcom",
  "version": "1.0.0",
  "description": "The validation layer of a published JSON Schema tree: the verdict on one payload, in the terms a JSON Schema validator emits.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@jsonspecshq/adcom-types": "file:../types"
  },
  "private": true
}
